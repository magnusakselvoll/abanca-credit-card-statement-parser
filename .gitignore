## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Local test data (may contain real bank data — never commit)
local-test-data/

# macOS
.DS_Store

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env
appsettings.User.json

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
logs/

# Build results on Bin directories
**/[Bb]in/*

# Visual Studio 2015/2017 cache
.vs/

# MSTest test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Coverage
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Python
**/__pycache__/
*.pyc

# Misc
*.tmp
*.log
*.binlog
MSBuild_Logs/
publish/
